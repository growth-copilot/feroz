<script>
(function () {
  if (window.__reviewsViewListenerAttached) return;
  window.__reviewsViewListenerAttached = true;

  function findReviews() {
    return document.querySelector('.stamped-reviews') || document.querySelector('.stamped-content');
  }

  function publishReviewsView(el) {
    if (!(window.Shopify && window.Shopify.analytics && window.Shopify.analytics.publish)) return;
    window.Shopify.analytics.publish('reviews_viewed', {
      review_count: el.querySelectorAll('.stamped-review').length || null
    });
  }

  function observeVisibility(el) {
    if (!('IntersectionObserver' in window)) { publishReviewsView(el); return; }
    var fired = false;
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (fired || !entry.isIntersecting) return;
        var ratioElement = entry.intersectionRatio;
        var ratioViewport = entry.intersectionRect.height / window.innerHeight;
        if (ratioElement >= 0.5 || ratioViewport >= 0.5) {
          fired = true;
          publishReviewsView(el);
          io.disconnect();
        }
      });
    }, { threshold: [0, 0.25, 0.5, 0.75, 1] });
    io.observe(el);
  }

  function start() {
    var el = findReviews();
    if (el) { observeVisibility(el); return; }

    var mo = new MutationObserver(function () {
      var found = findReviews();
      if (found) { mo.disconnect(); observeVisibility(found); }
    });
    mo.observe(document.body, { childList: true, subtree: true });

    setTimeout(function () { mo.disconnect(); }, 20000);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', start);
  } else {
    start();
  }
})();
</script>
