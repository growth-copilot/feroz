<script>
(function () {
  if (window.__thumbClickListenerAttached) return;
  window.__thumbClickListenerAttached = true;
  document.addEventListener('click', function (e) {
    var slide = e.target.closest('.swiper-slide');
    if (!slide) return;
    // Asegura que sea la galería de thumbnails y no el swiper principal
    var container = slide.closest('.p-pdp-thumbnails');
    if (!container) return;
    // Posición desde el aria-label ("2 / 5")
    var label = slide.getAttribute('aria-label') || '';
    var parts = label.split('/');
    var position = parseInt(parts[0], 10) || null;
    var total = parseInt(parts[1], 10) || null;
    // Fallback: si no hay aria-label, calcular por índice
    if (!position) {
      var slides = Array.prototype.slice.call(container.querySelectorAll('.swiper-slide'));
      position = slides.indexOf(slide) + 1;
      total = slides.length;
    }
    // Tipo de media
    var mediaType = slide.querySelector('.thumb-video') ? 'video' : 'image';
    // Publica hacia el custom pixel (que ahora tiene GTM adentro)
    if (window.Shopify && window.Shopify.analytics && window.Shopify.analytics.publish) {
      window.Shopify.analytics.publish('thumbnail_click', {
        position: position,   // 1, 2, 3...
        total: total,         // 5
        media_type: mediaType // "image" | "video"
      });
    }
  });
})();
</script>
