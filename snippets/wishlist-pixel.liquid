<script>
(function () {
  if (window.__wishlistListenerAttached) return;
  window.__wishlistListenerAttached = true;

  document.addEventListener('click', function (e) {
    var button = e.target.closest('favorite-button');
    if (!button) return;

    var scope = button.closest('.p-card') || document;
    var dataEl = scope.querySelector('script[p-product-data]');
    if (!dataEl) return;

    var data;
    try { data = JSON.parse(dataEl.textContent); } catch (err) { return; }

    var variant = data.variants && data.variants[0];
    if (!variant) return;

    var price = data.price / 100; 

    // Publica el evento hacia el custom pixel 
    if (window.Shopify && window.Shopify.analytics && window.Shopify.analytics.publish) {
      window.Shopify.analytics.publish('add_to_wishlist_click', {
        value: price,
        currency: (window.Shopify.currency && window.Shopify.currency.active) || 'EUR',
        items: [{
          id: String(variant.id),
          name: data.title,
          brand: data.vendor,
          category: data.type,
          price: price,
          quantity: 1
        }]
      });
    }
  });
})();
</script>
